---
import { siteConfig } from '../config/siteConfig';
import ThemeToggle from './ThemeToggle.astro';

const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) =>
  href === '/' ? currentPath === '/' : currentPath === href || currentPath.startsWith(`${href}/`);
---

<header class="site-header" data-pagefind-ignore="all">
  <div class="bar">
    <a href="/" class="brand">{siteConfig.author}</a>
    <nav aria-label="Main">
      {siteConfig.nav.filter((item) => siteConfig.blogEnabled || !('blog' in item)).map((item) => (
        <a href={item.href} class:list={[{ active: isActive(item.href) }]} aria-current={isActive(item.href) ? 'page' : undefined}>
          {item.label}
        </a>
      ))}
      <ThemeToggle />
    </nav>
  </div>
</header>

<style>
  .bar {
    max-width: var(--measure);
    margin: 0 auto;
    padding: 2.2rem 1.5rem 0;
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .brand {
    font-size: 1.05rem;
    font-weight: 500;
    color: var(--ink);
    text-decoration: none;
  }
  nav {
    display: flex;
    align-items: baseline;
    gap: 1.2rem;
    font-size: 0.95rem;
    flex-wrap: wrap;
  }
  nav a {
    color: var(--muted);
    text-decoration: none;
  }
  nav a:hover,
  nav a.active {
    color: var(--ink);
  }
  @media (max-width: 640px) {
    .bar {
      padding-top: 1.4rem;
    }
    nav {
      gap: 0.9rem;
      font-size: 0.9rem;
    }
  }
</style>
