---
interface Props {
  taggedPosts: Map<string, { slug: string; title: string }[]>;
  currentSlug: string;
  categoryName: string;
}

const { taggedPosts, currentSlug, categoryName } = Astro.props;
const tags = Array.from(taggedPosts.keys());
---

<aside class="post-sidebar">
  <div class="sidebar-header">
    <span class="category-label">{categoryName}</span>
  </div>

  <nav class="sidebar-nav">
    {tags.map(tag => {
      const posts = taggedPosts.get(tag) || [];
      const hasCurrentPost = posts.some(p => p.slug === currentSlug);
      return (
        <details class="tag-section" open={hasCurrentPost}>
          <summary class="tag-header">
            <span class="collapse-icon"></span>
            <span class="tag-name">#{tag}</span>
            <span class="post-count">{posts.length}</span>
          </summary>
          <ul class="post-list">
            {posts.map(post => (
              <li>
                <a
                  href={`/blog/${post.slug}`}
                  class:list={['post-link', { active: post.slug === currentSlug }]}
                >
                  {post.title}
                </a>
              </li>
            ))}
          </ul>
        </details>
      );
    })}
  </nav>
</aside>

<style>
  .post-sidebar {
    position: sticky;
    top: 80px;
    height: fit-content;
    max-height: calc(100vh - 100px);
    overflow-y: auto;
    padding: 1rem;
    background-color: var(--color-bg-secondary);
    border-radius: 8px;
    font-size: 0.9rem;
  }

  .post-sidebar::-webkit-scrollbar {
    width: 4px;
  }

  .post-sidebar::-webkit-scrollbar-track {
    background: transparent;
  }

  .post-sidebar::-webkit-scrollbar-thumb {
    background-color: var(--color-border);
    border-radius: 2px;
  }

  .sidebar-header {
    padding-bottom: 0.75rem;
    margin-bottom: 0.75rem;
    border-bottom: 1px solid var(--color-border);
  }

  .category-label {
    font-weight: 600;
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-primary);
  }

  .sidebar-nav {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .tag-section {
    border-radius: 4px;
  }

  .tag-header {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 0.25rem;
    cursor: pointer;
    user-select: none;
    font-weight: 500;
    color: var(--color-text);
    list-style: none;
    border-radius: 4px;
    transition: background-color 0.15s ease;
  }

  .tag-header::-webkit-details-marker {
    display: none;
  }

  .tag-header:hover {
    background-color: var(--color-bg);
  }

  .collapse-icon {
    width: 0;
    height: 0;
    border-left: 5px solid var(--color-text);
    border-top: 4px solid transparent;
    border-bottom: 4px solid transparent;
    opacity: 0.5;
    transition: transform 0.2s ease;
  }

  .tag-section[open] > .tag-header .collapse-icon {
    transform: rotate(90deg);
  }

  .tag-name {
    flex: 1;
    color: var(--color-text);
  }

  .post-count {
    font-size: 0.75rem;
    color: var(--color-text);
    opacity: 0.5;
    background-color: var(--color-bg);
    padding: 0.1rem 0.4rem;
    border-radius: 10px;
  }

  .post-list {
    list-style: none;
    padding: 0;
    margin: 0 0 0.5rem 0;
  }

  .post-list li {
    position: relative;
    padding-left: 1.25rem;
  }

  .post-list li::before {
    content: '';
    position: absolute;
    left: 0.5rem;
    top: 0;
    bottom: 0;
    width: 1px;
    background-color: var(--color-border);
  }

  .post-list li:last-child::before {
    bottom: 50%;
  }

  .post-link {
    display: block;
    padding: 0.35rem 0.5rem;
    color: var(--color-text);
    text-decoration: none;
    border-radius: 4px;
    line-height: 1.4;
    transition: background-color 0.15s ease, color 0.15s ease;
    opacity: 0.8;
  }

  .post-link:hover {
    background-color: var(--color-bg);
    opacity: 1;
  }

  .post-link.active {
    background-color: var(--color-primary);
    color: white;
    opacity: 1;
    font-weight: 500;
  }

  @media (max-width: 1024px) {
    .post-sidebar {
      position: static;
      max-height: none;
      margin-bottom: 2rem;
    }
  }
</style>
