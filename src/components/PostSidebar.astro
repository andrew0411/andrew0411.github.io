---
// "More in <category>" list shown at the end of a post, grouped by tag.
interface Props {
  taggedPosts: Map<string, { slug: string; title: string }[]>;
  currentSlug: string;
  categoryName: string;
}

const { taggedPosts, currentSlug, categoryName } = Astro.props;
const groups = [...taggedPosts.entries()].filter(([, posts]) => posts.some((p) => p.slug !== currentSlug));
---

{groups.length > 0 && (
  <section class="more">
    <h2 class="section-title">More in {categoryName}</h2>
    {groups.map(([tag, posts]) => (
      <div class="group">
        <h3>{tag}</h3>
        <ul>
          {posts.map((p) => (
            <li>
              {p.slug === currentSlug
                ? <span aria-current="page">{p.title}</span>
                : <a href={`/blog/${p.slug}`}>{p.title}</a>}
            </li>
          ))}
        </ul>
      </div>
    ))}
  </section>
)}

<style>
  .more {
    padding-top: 1.4rem;
    border-top: 1px solid var(--rule);
  }
  .group + .group {
    margin-top: 0.9rem;
  }
  h3 {
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--muted);
    margin-bottom: 0.2rem;
  }
  ul {
    list-style: none;
  }
  li {
    padding: 0.15rem 0;
  }
  [aria-current='page'] {
    color: var(--muted);
  }
</style>
