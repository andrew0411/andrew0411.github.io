---
import { profile } from '../data/profile';
import { siteConfig } from '../config/siteConfig';
---

<footer data-pagefind-ignore="all">
  <div class="inner">
    <span>© {new Date().getFullYear()} {profile.name}</span>
    <span class="links">
      <a href={`mailto:${profile.email}`}>Email</a>
      <a href={profile.links.github}>GitHub</a>
      <a href={profile.links.scholar}>Google Scholar</a>
      {siteConfig.blogEnabled && <a href="/rss.xml">RSS</a>}
    </span>
  </div>
</footer>

<style>
  footer {
    margin-top: 4rem;
    padding: 0 1.5rem;
  }
  .inner {
    max-width: calc(var(--measure) - 3rem);
    margin: 0 auto;
    padding: 1.5rem 0 3rem;
    border-top: 1px solid var(--rule);
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.6rem 1rem;
    color: var(--muted);
    font-size: 0.85rem;
  }
  .links {
    display: flex;
    gap: 1rem;
  }
  .links a {
    color: var(--muted);
  }
  .links a:hover {
    color: var(--ink);
  }
</style>
