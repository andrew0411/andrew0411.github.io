---
import { profile } from '../data/profile';
import { getAllPosts } from '../lib/content';
import { categories } from '../config/categories';

const recent = (await getAllPosts()).slice(0, 4);
const fmt = (d: Date) => d.toLocaleDateString('en-US', { month: 'short', year: 'numeric', timeZone: 'UTC' });
const catName = (id: string) => categories.find((c) => c.id === id)?.name ?? id;
const { links, researchInterests } = profile;
---

<div class="page">
  <div class="intro">
    <div>
      <h1 class="page-title">{profile.name}</h1>
      <p>
        I am a second-year Ph.D. student in Industrial and Systems Engineering at the
        <a href="https://www.wisc.edu/">University of Wisconsin–Madison</a>, advised by
        <a href={profile.advisor.href}>{profile.advisor.name}</a> in the {profile.lab}.
        I develop machine learning methods for time-series data from engineered systems, with a focus on
        anomaly detection and surrogate modeling for energy systems and industrial control systems.
      </p>
      <p>
        Before joining UW–Madison, I worked as an AI researcher at AhnLab and earned my B.S. and M.S. in
        Industrial and Systems Engineering at Dongguk University, Korea, under the supervision of
        <a href={profile.previousAdvisor.href}>{profile.previousAdvisor.name}</a>.
      </p>
      <p class="links">
        <a href={`mailto:${profile.email}`}>Email</a>
        <a href="/cv">CV</a>
        <a href={links.scholar}>Google Scholar</a>
        <a href={links.github}>GitHub</a>
        <a href={links.linkedin}>LinkedIn</a>
      </p>
    </div>
    <img src={profile.photo} alt={`Portrait of ${profile.name}`} width="150" height="188" />
  </div>

  <section class="section">
    <h2 class="section-title">Research interests</h2>
    <p class="ri"><span class="ri-label">Methodology:</span> {researchInterests.methodology.join(', ')}.</p>
    <p class="ri"><span class="ri-label">Applications:</span> {researchInterests.applications.join(', ')}.</p>
  </section>

  <section class="section">
    <h2 class="section-title">News</h2>
    <ul class="rows">
      {profile.news.map((n) => (
        <li><time>{n.date}</time><span>{n.text}</span></li>
      ))}
    </ul>
  </section>

  {recent.length > 0 && <section class="section">
    <h2 class="section-title">Recent writing</h2>
    <ul class="rows">
      {recent.map((p) => (
        <li>
          <time datetime={p.data.date.toISOString()}>{fmt(p.data.date)}</time>
          <span><a href={`/blog/${p.slug}`}>{p.data.title}</a><span class="meta">{catName(p.data.category)}</span></span>
        </li>
      ))}
    </ul>
    <p class="all"><a href="/blog">All posts</a></p>
  </section>}
</div>

<style>
  .intro {
    display: grid;
    grid-template-columns: 1fr 150px;
    gap: 2rem;
    align-items: start;
    padding-bottom: 1.5rem;
  }
  .intro p {
    margin-top: 1.1rem;
    line-height: 1.65;
  }
  .intro img {
    width: 150px;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    margin-top: 0.4rem;
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem 1rem;
    font-size: 0.95rem;
  }
  .ri {
    line-height: 1.6;
    margin-bottom: 0.4rem;
  }
  .ri-label {
    font-style: italic;
  }
  .all {
    margin-top: 0.8rem;
    font-size: 0.95rem;
  }
  @media (max-width: 640px) {
    .intro {
      grid-template-columns: 1fr;
      gap: 0;
    }
    .intro img {
      grid-row: 1;
      width: 120px;
      margin: 0 0 1rem;
    }
  }
</style>
