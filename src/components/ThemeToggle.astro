<button id="theme-toggle" type="button" aria-label="Switch to dark theme" title="Switch to dark theme">
  <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <g class="rays">
      <line x1="12" y1="1.5" x2="12" y2="3" />
      <line x1="4.6" y1="4.6" x2="5.7" y2="5.7" />
      <line x1="19.4" y1="4.6" x2="18.3" y2="5.7" />
      <line x1="2" y1="11" x2="3.5" y2="11" />
      <line x1="22" y1="11" x2="20.5" y2="11" />
    </g>
    <path class="glass" d="M9 17.5h6M9.6 20.5h4.8M12 6a5 5 0 0 0-3 9c.6.5 1 1.2 1 2v.5h4V17c0-.8.4-1.5 1-2a5 5 0 0 0-3-9Z" />
  </svg>
</button>

<style>
  #theme-toggle {
    background: none;
    border: none;
    cursor: pointer;
    color: var(--muted);
    padding: 0.15rem;
    display: inline-flex;
    align-self: center;
    border-radius: 4px;
  }
  #theme-toggle:hover {
    color: var(--ink);
  }
  /* light theme = light on: rays visible, glass tinted */
  #theme-toggle .glass {
    fill: color-mix(in srgb, var(--accent) 12%, transparent);
  }
  :global([data-theme='dark']) #theme-toggle .rays {
    display: none;
  }
  :global([data-theme='dark']) #theme-toggle .glass {
    fill: none;
  }
</style>

<script is:inline>
  (function () {
    const btn = document.getElementById('theme-toggle');
    if (!btn) return;
    const label = (t) => {
      const text = t === 'dark' ? 'Switch to light theme' : 'Switch to dark theme';
      btn.setAttribute('aria-label', text);
      btn.setAttribute('title', text);
    };
    label(document.documentElement.dataset.theme || 'light');
    btn.addEventListener('click', () => {
      const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
      document.documentElement.dataset.theme = next;
      try { localStorage.setItem('theme', next); } catch (e) {}
      label(next);
    });
  })();
</script>
