---
import BaseLayout from './BaseLayout.astro';
import PostSidebar from '../components/PostSidebar.astro';
import type { CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'blog'>;
  prevPost?: { slug: string; title: string } | null;
  nextPost?: { slug: string; title: string } | null;
  taggedPosts: Map<string, { slug: string; title: string }[]>;
  categoryName: string;
}

const { post, prevPost, nextPost, taggedPosts, categoryName } = Astro.props;
const { title, date, category, tags, summary } = post.data;
const longDate = date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
---

<BaseLayout title={title} description={summary}>
  <article class="page post">
    <header class="post-header">
      <h1 class="page-title">{title}</h1>
      <p class="post-meta">
        <time datetime={date.toISOString()}>{longDate}</time>, in
        <a href={`/blog/category/${category}`}>{categoryName}</a>
        {tags.length > 0 && (
          <Fragment>
            <span class="sep" aria-hidden="true">/</span>
            {tags.map((tag, i) => <Fragment>{i > 0 && ', '}<a class="tag" href={`/blog/tag/${tag}`}>{tag}</a></Fragment>)}
          </Fragment>
        )}
      </p>
    </header>

    <div class="prose">
      <slot />
    </div>

    <footer class="post-footer" data-pagefind-ignore>
      <nav class="post-navigation" aria-label="Adjacent posts">
        <div>
          {prevPost && (
            <Fragment>
              <span class="nav-label">Older</span>
              <a href={`/blog/${prevPost.slug}`}>{prevPost.title}</a>
            </Fragment>
          )}
        </div>
        <div class="next">
          {nextPost && (
            <Fragment>
              <span class="nav-label">Newer</span>
              <a href={`/blog/${nextPost.slug}`}>{nextPost.title}</a>
            </Fragment>
          )}
        </div>
      </nav>
      <PostSidebar taggedPosts={taggedPosts} currentSlug={post.slug} categoryName={categoryName} />
    </footer>
  </article>
</BaseLayout>

<style>
  .post-header {
    margin-bottom: 2.2rem;
  }
  .post-meta {
    color: var(--muted);
    font-size: 0.92rem;
  }
  .post-meta a {
    color: var(--muted);
  }
  .post-meta a:hover {
    color: var(--ink);
  }
  .sep {
    margin: 0 0.4rem;
  }
  .post-footer {
    margin-top: 3.5rem;
  }
  .post-navigation {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
    padding: 1.4rem 0;
    border-top: 1px solid var(--rule);
  }
  .post-navigation div {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }
  .post-navigation .next {
    text-align: right;
  }
  .nav-label {
    font-size: 0.85rem;
    color: var(--muted);
    font-style: italic;
  }
  @media (max-width: 640px) {
    .post-navigation {
      grid-template-columns: 1fr;
      gap: 1rem;
    }
    .post-navigation .next {
      text-align: left;
    }
  }
</style>
