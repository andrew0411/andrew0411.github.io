---
import BaseLayout from '../layouts/BaseLayout.astro';
import Citation from '../components/Citation.astro';
import { profile } from '../data/profile';
---

<BaseLayout title="Publications" description={`Publications and presentations of ${profile.name}`}>
  <div class="page">
    <h1 class="page-title">Publications</h1>
    <p class="lead">Also on <a href={profile.links.scholar}>Google Scholar</a>.</p>

    <section class="section">
      <h2 class="section-title">Journal articles</h2>
      <ol class="refs">
        {profile.publications.map((p) => <li><Citation item={p} /></li>)}
      </ol>
    </section>

    <section class="section">
      <h2 class="section-title">Presentations</h2>
      <ol class="refs">
        {profile.presentations.map((p) => <li><Citation item={p} /></li>)}
      </ol>
    </section>
  </div>
</BaseLayout>

<style>
  .lead {
    color: var(--muted);
    margin-bottom: 1.5rem;
  }
  .refs {
    list-style: none;
    counter-reset: ref;
  }
  .refs li {
    counter-increment: ref;
    position: relative;
    padding-left: 2rem;
    margin-bottom: 1rem;
    line-height: 1.55;
  }
  .refs li::before {
    content: counter(ref) '.';
    position: absolute;
    left: 0;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }
</style>
