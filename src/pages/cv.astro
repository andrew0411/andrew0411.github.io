---
import BaseLayout from '../layouts/BaseLayout.astro';
import Citation from '../components/Citation.astro';
import { profile, type Entry } from '../data/profile';

const sections: { title: string; entries: Entry[] }[] = [
  { title: 'Education', entries: profile.education },
  { title: 'Research Experience', entries: profile.researchExperience },
];
const websiteLabel = profile.website.replace(/^https?:\/\//, '');
---

<BaseLayout title="Curriculum Vitae" description={`Curriculum Vitae of ${profile.name}`}>
  <div class="cv-toolbar">
    <a class="download" href="/cv.pdf" download="CV_Jaehwan_Lee.pdf">Download PDF</a>
    <span class="updated">Last updated: {profile.lastUpdated}</span>
  </div>

  <article class="cv">
    <header class="cv-header">
      <h1>{profile.name}</h1>
      <p>{profile.position}, {profile.department}, {profile.university}</p>
      <p>{profile.address}</p>
      <p class="contact">
        <a href={`mailto:${profile.email}`}>{profile.email}</a>
        <span>|</span><a href={profile.website}>{websiteLabel}</a>
        <span>|</span><a href={profile.links.github}>GitHub</a>
        <span>|</span><a href={profile.links.scholar}>Google Scholar</a>
        <span>|</span><a href={profile.links.linkedin}>LinkedIn</a>
      </p>
    </header>

    <section>
      <h2>Research Interests</h2>
      <p><strong>Methodology:</strong> {profile.researchInterests.methodology.join(', ')}</p>
      <p><strong>Applications:</strong> {profile.researchInterests.applications.join(', ')}</p>
    </section>

    {sections.map((s) => (
      <section>
        <h2>{s.title}</h2>
        {s.entries.map((e) => (
          <div class="entry">
            <div class="row"><strong>{e.org}</strong><span>{e.location}</span></div>
            <div class="row"><em>{e.role}</em><span>{e.dates}</span></div>
            {e.lines?.map((l) => <p class="line">{l}</p>)}
            {e.bullets && <ul>{e.bullets.map((b) => <li>{b}</li>)}</ul>}
            {e.projects?.map((p) => (
              <div class="project">
                <div class="row"><span>{p.title}</span><span>{p.dates}</span></div>
                {p.bullets && <ul>{p.bullets.map((b) => <li>{b}</li>)}</ul>}
              </div>
            ))}
          </div>
        ))}
      </section>
    ))}

    <section>
      <h2>Publications</h2>
      <ol class="refs">
        {profile.publications.map((p) => <li><Citation item={p} /></li>)}
      </ol>
    </section>

    <section>
      <h2>Presentations</h2>
      <ol class="refs">
        {profile.presentations.map((p) => <li><Citation item={p} /></li>)}
      </ol>
    </section>

    <section>
      <h2>Teaching Experience</h2>
      {profile.teaching.map((e) => (
        <div class="entry">
          <div class="row"><strong>{e.org}</strong><span>{e.location}</span></div>
          <div class="row"><em>{e.role}</em><span>{e.dates}</span></div>
          {e.lines && <ul>{e.lines.map((l) => <li>{l}</li>)}</ul>}
        </div>
      ))}
    </section>

    <section>
      <h2>Honors and Awards</h2>
      {profile.honors.map((h) => (
        <div class="row item"><span>{h.title}</span><span>{h.date}</span></div>
      ))}
    </section>

    <section>
      <h2>Academic Service and Memberships</h2>
      <p><strong>Reviewer:</strong> {profile.service.reviewer.join(', ')}</p>
      {profile.service.memberships.map((m) => (
        <div class="row item"><span><strong>Membership:</strong> {m.title}</span><span>{m.date}</span></div>
      ))}
    </section>

    <section>
      <h2>Technical Skills</h2>
      {profile.skills.map((s) => (
        <p><strong>{s.label}:</strong> {s.items}</p>
      ))}
    </section>

    <section>
      <h2>Military Service</h2>
      <div class="entry">
        <div class="row"><strong>{profile.military.org}</strong><span>{profile.military.location}</span></div>
        <div class="row"><em>{profile.military.role}</em><span>{profile.military.dates}</span></div>
        {profile.military.lines?.map((l) => <p class="line">{l}</p>)}
      </div>
    </section>
  </article>
</BaseLayout>

<style>
  .cv-toolbar {
    max-width: 800px;
    margin: 0 auto;
    padding: 3rem 1.5rem 0;
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .download {
    display: inline-block;
    padding: 0.35rem 0.9rem;
    border: 1px solid var(--accent);
    border-radius: 3px;
    text-decoration: none;
  }

  .download:hover {
    background-color: var(--accent);
    color: var(--bg);
  }

  .updated {
    font-size: 0.85rem;
    color: var(--muted);
  }

  .cv {
    max-width: 800px;
    margin: 2rem auto 0;
    padding: 0 1.5rem;
    font-size: 0.9rem;
    line-height: 1.5;
  }

  .cv-header {
    text-align: center;
    margin-bottom: 1.25rem;
  }

  .cv-header h1 {
    font-size: 2.2rem;
    font-weight: 400;
    margin-bottom: 0.25rem;
  }

  .contact span {
    margin: 0 0.4rem;
    color: var(--muted);
  }

  .cv h2 {
    font-size: 1.1rem;
    font-weight: 500;
    font-style: italic;
    border-bottom: 1px solid var(--rule);
    margin: 1.5rem 0 0.6rem;
    padding-bottom: 0.2rem;
  }

  .cv p {
    margin-bottom: 0.2rem;
  }

  .entry {
    margin-bottom: 0.6rem;
  }

  .entry > .row {
    break-after: avoid;
  }

  .row {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
  }

  .row > span:last-child,
  .row > span:only-child {
    white-space: nowrap;
  }

  .row > span:first-child:not(:only-child) {
    white-space: normal;
  }

  .item {
    margin-bottom: 0.15rem;
  }

  .line {
    margin-left: 0;
  }

  .project {
    margin-top: 0.25rem;
    break-inside: avoid;
  }

  .project .row > span:first-child {
    font-weight: 500;
  }

  .cv ul {
    margin: 0.15rem 0 0.25rem 1.25rem;
  }

  .cv li {
    margin-bottom: 0.1rem;
  }

  .refs {
    margin-left: 1.5rem;
  }

  .refs li {
    margin-bottom: 0.35rem;
    break-inside: avoid;
  }

  @media (max-width: 640px) {
    .row {
      flex-direction: column;
      gap: 0;
    }

    .row > span:last-child {
      opacity: 0.75;
    }
  }

  @media print {
    @page {
      size: Letter;
      margin: 0.55in 0.6in;
    }

    :global(html),
    :global(html[data-theme]),
    :global(body) {
      --ink: #000;
      --bg: #fff;
      --muted: #333;
      --rule: #000;
      --accent: #1a4fa0;
      background: #fff !important;
      color: #000 !important;
    }

    :global(.site-header),
    :global(.skip-link),
    :global(nav),
    :global(footer),
    .cv-toolbar {
      display: none !important;
    }

    .cv {
      max-width: none;
      margin: 0;
      padding: 0;
      font-size: 10pt;
      line-height: 1.35;
      font-family: 'Times New Roman', Times, serif;
    }

    .cv a {
      color: #000;
    }

    :global(.cv a) {
      text-decoration: none;
    }

    .cv-header h1 {
      font-size: 18pt;
      font-weight: 700;
      letter-spacing: 0.04em;
      text-transform: uppercase;
    }

    .cv h2 {
      font-size: 10.5pt;
      font-weight: 700;
      font-style: normal;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      border-bottom-color: #000;
      margin-top: 0.8rem;
      break-after: avoid;
    }

    .row {
      flex-direction: row !important;
    }
  }
</style>
