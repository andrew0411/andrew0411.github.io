---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Curriculum Vitae" description="CV of Your Name">
  <div class="content-wrapper">
    <h1>Curriculum Vitae</h1>
    <p>You can download my CV here:</p>
    <p><a href="/cv.pdf" target="_blank">Download CV (PDF)</a></p>
    <p>Last updated: <em>2025-10-20</em></p>
  </div>
</BaseLayout>

<style>
  .content-wrapper {
    max-width: 800px;
    margin: 2rem auto;
    padding: 0 1rem;
  }
  .content-wrapper h1 {
    font-size: 2rem;
    margin-bottom: 1rem;
  }
  .content-wrapper p {
    margin-bottom: 1rem;
  }
</style>
