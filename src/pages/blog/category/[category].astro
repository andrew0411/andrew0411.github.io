---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PostList from '../../../components/PostList.astro';
import CategoryNav from '../../../components/CategoryNav.astro';
import { getPostsByCategory, getUniqueTagsInCategory } from '../../../lib/content';
import { categories } from '../../../config/categories';
import { siteConfig } from '../../../config/siteConfig';

export async function getStaticPaths() {
  if (!siteConfig.blogEnabled) return [];
  return categories.map((cat) => ({ params: { category: cat.id } }));
}

const { category } = Astro.params;
const posts = await getPostsByCategory(category);
const tags = await getUniqueTagsInCategory(category);
const categoryName = categories.find((c) => c.id === category)?.name || category;
---

<BaseLayout title={categoryName} description={`Posts in ${categoryName}`}>
  <div class="page">
    <h1 class="page-title">{categoryName}</h1>
    <p class="lead">{posts.length} {posts.length === 1 ? 'post' : 'posts'}</p>
    <CategoryNav current={category} />
    {tags.length > 0 && (
      <p class="tags">Tags: {tags.map((t, i) => <Fragment>{i > 0 && ', '}<a href={`/blog/tag/${t}`}>{t}</a></Fragment>)}</p>
    )}
    <PostList posts={posts} showCategory={false} />
  </div>
</BaseLayout>

<style>
  .lead {
    color: var(--muted);
    margin-bottom: 1.2rem;
  }
  .tags {
    font-size: 0.9rem;
    color: var(--muted);
    margin: -0.6rem 0 1.4rem;
  }
</style>
