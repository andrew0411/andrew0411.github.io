---
import { getAllPosts, getPostsGroupedByTagInCategory } from '../../lib/content';
import { render } from 'astro:content';
import BlogPost from '../../layouts/BlogPost.astro';
import { categories } from '../../config/categories';

export async function getStaticPaths() {
  const allPosts = await getAllPosts();
  return allPosts.map(post => ({ params: { slug: post.slug } }));
}

const { slug } = Astro.params;
const allPosts = await getAllPosts();
const index = allPosts.findIndex(post => post.slug === slug);
if (index === -1) {
  throw new Error(`Post not found: ${slug}`);
}
const post = allPosts[index];
const prevPost = index < allPosts.length - 1 ? { slug: allPosts[index + 1].slug, title: allPosts[index + 1].data.title } : null;
const nextPost = index > 0 ? { slug: allPosts[index - 1].slug, title: allPosts[index - 1].data.title } : null;
const { Content } = await render(post);

const taggedPosts = await getPostsGroupedByTagInCategory(post.data.category);
const categoryName = categories.find(c => c.id === post.data.category)?.name || post.data.category;
---

<BlogPost post={post} prevPost={prevPost} nextPost={nextPost} taggedPosts={taggedPosts} categoryName={categoryName}>
  <Content />
</BlogPost>
