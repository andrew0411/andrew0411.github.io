---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Search" description="Search blog posts">
  <div class="page">
    <h1 class="page-title">Search</h1>
    <p class="lead">Search posts and pages by keyword.</p>
    <div id="search-container"></div>
  </div>

  <link rel="stylesheet" href="/pagefind/pagefind-ui.css" />
  <script src="/pagefind/pagefind-ui.js" is:inline></script>
  <script is:inline>
    window.addEventListener('DOMContentLoaded', () => {
      new PagefindUI({ element: '#search-container', showImages: false, resetStyles: false });
    });
  </script>
</BaseLayout>

<style>
  .lead {
    color: var(--muted);
    margin-bottom: 1.5rem;
  }
  #search-container {
    --pagefind-ui-scale: 0.9;
    --pagefind-ui-primary: var(--accent);
    --pagefind-ui-text: var(--ink);
    --pagefind-ui-background: var(--bg);
    --pagefind-ui-border: var(--rule);
    --pagefind-ui-tag: var(--soft);
    --pagefind-ui-border-width: 1px;
    --pagefind-ui-border-radius: 3px;
    --pagefind-ui-font: var(--font-serif);
  }
</style>
